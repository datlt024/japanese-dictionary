{
  "name": "japanese-dictionary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:jmdict": "tsx scripts/import/import-jmdict.ts",
    "import:jlpt-vocab": "tsx --env-file=.env.local scripts/import/import-jlpt-vocab.ts",
    "import:kanjidic": "tsx scripts/import/import-kanjidic.ts",
    "import:grammars": "tsx scripts/import/import-grammars.ts",
    "build:kanji-links": "tsx scripts/build/build-kanji-links.ts",
    "build:kanji-readings": "tsx scripts/build/build-kanji-reading-examples.ts",
    "grammar:enrich": "tsx scripts/grammar/enrich-grammars.ts",
    "grammar:apply": "tsx scripts/grammar/apply-grammar-results.ts",
    "import:pitch-accents": "tsx scripts/import/import-pitch-accents.ts",
    "vocab:generate-vi": "tsx --env-file=.env.local scripts/generate/generate-vocabulary-vi.ts",
    "vocab:generate-vi:jlpt": "tsx --env-file=.env.local scripts/generate/generate-vocabulary-vi.ts --jlpt",
    "vocab:retranslate-jlpt": "python3 -u scripts/generate/retranslate-jlpt-vi-google.py",
    "vocab:retranslate-jlpt-gemini": "python3 -u scripts/generate/retranslate-jlpt-vi-gemini.py",
    "vocab:apply-vi": "tsx scripts/generate/apply-vocabulary-vi-results.ts",
    "vocab:import-vi": "tsx --env-file=.env.local scripts/import/bulk-import-vocabulary-vi.ts",
    "vocab:import-examples": "python3 -u scripts/import/import-vocabulary-examples.py",
    "kanji:generate-vi": "tsx scripts/generate/generate-kanji-vi.ts",
    "kanji:translate-vi": "python3 -u scripts/generate/translate-kanji-vi.py",
    "vocab:enrich-ruby": "python3 -u scripts/generate/enrich-vocabulary-ruby.py",
    "kanji:generate-memory-tips": "tsx --env-file=.env.local scripts/generate/generate-kanji-memory-tips.ts",
    "collocation:generate-vi": "tsx --env-file=.env.local scripts/generate/generate-collocation-vi.ts",
    "collocation:translate-vi": "python3 -u scripts/generate/translate-collocation-vi.py",
    "import:relations": "tsx --env-file=.env.local scripts/import/import-jmdict-relations.ts",
    "import:antonyms": "tsx --env-file=.env.local scripts/import/import-antonyms.ts",
    "import:synonyms": "tsx --env-file=.env.local scripts/import/import-synonyms.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.2",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.9.3",
    "lucide-react": "^1.17.0",
    "next": "15.5.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.4.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "supabase": "^2.104.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
